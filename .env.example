# ── Database ───────────────────────────────────────────────────────────────
# AsyncPostgresSaver uses psycopg3 directly — do NOT use the +asyncpg:// prefix.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# On macOS with default Postgres, USER is your system username and PASSWORD may
# be empty — but it's safer to create a dedicated role:
#   createdb onboarding_db
#   psql onboarding_db -c "CREATE USER onboarding_user WITH PASSWORD 'secret';"
#   psql onboarding_db -c "GRANT ALL PRIVILEGES ON DATABASE onboarding_db TO onboarding_user;"
DATABASE_URL=postgresql://onboarding_user:secret@localhost:5432/onboarding_db

# Celery/SQLAlchemy sync driver (same format, used by workers)
SYNC_DATABASE_URL=postgresql://onboarding_user:secret@localhost:5432/onboarding_db

# ── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM (swap for your provider) ───────────────────────────────────────────
# A real key was committed here previously — if you have not already, revoke it
# at https://platform.openai.com/api-keys. Unused by the app (NVIDIA NIM below
# is the LLM), but anything in an example file should be assumed public.
OPENAI_API_KEY=sk-proj-REPLACE_ME

# ── PII Encryption (generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())") ──
PII_ENCRYPTION_KEY_B64=BASE64_ENCODED_32_BYTE_KEY_HERE

# ── SMTP ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hr@company.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=hr-noreply@company.com

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=compliance_docs
# ═══════════════════════════════════════════════════════════════════════════
# Voice follow-up agent (§16)
# ═══════════════════════════════════════════════════════════════════════════

# Master switch. With this false nothing is armed, scheduled or dialled.
VOICE_AGENT_ENABLED=false

INITIAL_CALL_ENABLED=true
FINAL_CALL_ENABLED=true

# Delay between the Offer Letter being DISPATCHED and the first call.
# 3 = the testing window. 4320 = 3 days, the intended production value.
# Changing this is a config change only — nothing in the code assumes minutes.
OFFER_CALL_DELAY_MINUTES=3

# Gap before the final call when the candidate gave no specific date.
FINAL_CALL_DELAY_MINUTES=5

# Redial spacing and budget per call type.
CALL_RETRY_DELAY_MINUTES=2
CALL_MAX_ATTEMPTS=3

# Permitted calling hours, IST. A 3-day delay scheduled in UTC will otherwise
# eventually dial someone at 3am. Calls outside the window are deferred.
CALL_WINDOW_START_HOUR_IST=10
CALL_WINDOW_END_HOUR_IST=19

# §13 — recording is OFF by default. Turning it on is a compliance decision,
# and in India you should announce it at the start of the call.
VOICE_RECORDING_ENABLED=false

# ── LiveKit ────────────────────────────────────────────────────────────────
# LIVEKIT_SIP_TRUNK_ID is a SIP trunk you have registered with LiveKit, from a
# telephony provider (Twilio / Plivo / Exotel). LiveKit alone CANNOT reach the
# PSTN. Outbound commercial calling to Indian subscribers is also subject to
# TRAI/DLT registration.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
VOICE_AGENT_NAME=offer-followup-agent

# ── Deepgram (STT + TTS) ───────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en-IN
DEEPGRAM_TTS_MODEL=aura-2-asteria-en

# Where the agent worker reaches this API to read status and report outcomes.
INTERNAL_API_BASE=http://127.0.0.1:8000

# ── HR console authentication ──────────────────────────────────────────────
# The HR endpoints release employment documents; they are authenticated.
# Unset HR_PASSWORD and the API generates one per run and prints it at startup.
# Prefer HR_PASSWORD_HASH in anything shared:
#   python3 -c "from core.auth import hash_password; print(hash_password('...'))"
HR_AUTH_ENABLED=true
HR_USERNAME=hr
HR_PASSWORD=
HR_PASSWORD_HASH=
HR_SESSION_HOURS=12

# Origins allowed to call the API. Never "*".
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
