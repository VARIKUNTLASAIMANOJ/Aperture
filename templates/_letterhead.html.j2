{# Shared letterhead + print styling for both statutory documents.
   Kept in one partial so the Offer and Appointment letters cannot drift
   apart visually, while remaining entirely separate documents (Rule 7). #}
<style>
  @page { size: A4 portrait; margin: 14mm 0; }
  body { font-family: 'Segoe UI', Arial, sans-serif; background:#f4f6f9; margin:0; padding:0; color:#1a1f2b; }
  .sheet { max-width:820px; margin:24px auto; background:#fff; border-radius:6px; overflow:hidden;
           box-shadow:0 2px 16px rgba(0,0,0,.08); }
  table.lh { width:100%; border-collapse:collapse;
             border-bottom:3px solid #0b3d91; }
  table.lh td { padding:24px 40px; vertical-align:middle; }
  table.lh td.co { font-size:20px; font-weight:700; color:#0b3d91; letter-spacing:-.2px; }
  table.lh td.co small { display:block; font-size:11px; font-weight:400; color:#5a6b85; letter-spacing:.4px; }
  table.lh td.meta { text-align:right; font-size:11px; color:#5a6b85; line-height:1.7; }
  .doctype { background:#0b3d91; color:#fff; text-align:center; padding:10px 40px;
             font-size:15px; font-weight:700; letter-spacing:2.5px; text-transform:uppercase; }
  .body { padding:32px 40px; font-size:13.5px; line-height:1.75; }
  h2.sec { font-size:11px; text-transform:uppercase; letter-spacing:1.4px; color:#0b3d91;
           border-bottom:1px solid #e3e8f0; padding-bottom:6px; margin:26px 0 12px; }
  table.kv { width:100%; border-collapse:collapse; font-size:13px; }
  table.kv td { padding:7px 0; border-bottom:1px solid #eef1f6; vertical-align:top; }
  table.kv td.k { color:#5a6b85; width:42%; }
  table.kv td.v { font-weight:600; text-align:right; }
  table.sal { width:100%; border-collapse:collapse; font-size:12.5px; margin-top:8px; }
  table.sal th { background:#eef2f8; color:#0b3d91; text-align:left; padding:8px 10px;
                 font-size:10.5px; text-transform:uppercase; letter-spacing:.8px; }
  table.sal td { padding:7px 10px; border-bottom:1px solid #eef1f6; }
  table.sal td.amt { text-align:right; font-variant-numeric:tabular-nums; }
  table.sal tr.total td { font-weight:700; background:#f7f9fc; border-top:2px solid #0b3d91; }
  table.sal tr.sub td { font-weight:600; background:#fafbfd; }
  .callout { background:#eef4ff; border-left:4px solid #0b3d91; padding:14px 18px; margin:18px 0;
             border-radius:0 4px 4px 0; font-size:13px; }
  .warn { background:#fff8e6; border-left:4px solid #c98a00; }
  ol.terms { padding-left:18px; margin:8px 0; }
  ol.terms li { margin-bottom:9px; }
  table.sign { width:100%; border-collapse:collapse; margin-top:36px; padding-top:20px;
               border-top:1px solid #e3e8f0; }
  table.sign td { width:50%; font-size:12px; color:#5a6b85; vertical-align:top;
                  padding-top:20px; }
  table.sign .line { margin-top:44px; border-top:1px solid #9aa8bd; padding-top:6px; }
  .foot { background:#f7f9fc; padding:14px 40px; font-size:10.5px; color:#8494ab;
          text-align:center; border-top:1px solid #e3e8f0; }
  .ctc { font-size:26px; font-weight:800; color:#0b3d91; font-variant-numeric:tabular-nums; }
</style>

<table class="lh"><tr>
  <td class="co">
    {{ company_name }}
    <small>{{ company_address }}{% if company_cin %} · CIN: {{ company_cin }}{% endif %}</small>
  </td>
  <td class="meta">
    <strong>Ref:</strong> {{ document_number }}<br>
    <strong>Date:</strong> {{ document_date }}
  </td>
</tr></table>
